# The package's own analysis, which follows the architecture it ships.
includes:
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - config/phpstan.neon

parameters:
    # PHPStan reads tmpDir only from this file and what it includes directly, not from config/phpstan.neon
    # as extension-installer includes it in a project, so each project sets it.
    tmpDir: cache/phpstan
    # PHPStan's strictest, which every project sets too, since config/phpstan.neon can't set it.
    level: 10
    paths:
        - src
        - bin/php-ianf-strict-baseline
        - tests
    excludePaths:
        # Breaks the rules on purpose
        - tests/fixtures
