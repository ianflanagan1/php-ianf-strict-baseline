includes:
    - ../../../vendor/spaze/phpstan-disallowed-calls/extension.neon
    - ../../../config/phpstan.neon

parameters:
    # As a project sets it: PHPStan reads the level only from this file and what it includes directly.
    level: 10
    paths:
        - src
        - bin
        - tests
    # The fake third-party packages the core calls, which a project's Composer autoloader would
    # find in its own vendor/. PHPStan reads their declarations from here and analyses none of
    # their code.
    scanDirectories:
        - vendor
